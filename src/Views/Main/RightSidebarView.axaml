<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:IRis.ViewModels.Main"
  x:DataType="vm:RightSidebarViewModel"
  x:Class="IRis.Views.Main.RightSidebarView"
  xmlns:components="using:IRis.ViewModels.Main.Canvas.CircuitObjects.Components"
  xmlns:gates="using:IRis.ViewModels.Main.Canvas.CircuitObjects.Components.Gates"
  xmlns:componentViews="using:IRis.Views.Main.Canvas.CircuitObjects.Components"
  xmlns:gateViews="using:IRis.Views.Main.Canvas.CircuitObjects.Components.Gates"
  IsVisible="{Binding IsVisible}"
  Width="200"
  FontSize="12"
>
  <UserControl.DataTemplates>
    <DataTemplate DataType="components:GateViewModel">
      <componentViews:GateView />
    </DataTemplate>
    <DataTemplate DataType="components:ToggleViewModel">
      <componentViews:ToggleView />
    </DataTemplate>
    <DataTemplate DataType="components:ClockViewModel">
      <componentViews:ClockView />
    </DataTemplate>
    <DataTemplate DataType="components:ProbeViewModel">
      <componentViews:ProbeView />
    </DataTemplate>
    <DataTemplate DataType="components:FullAdderViewModel">
      <componentViews:FullAdderView />
    </DataTemplate>
    <DataTemplate DataType="components:MultiplexerViewModel">
      <componentViews:MultiplexerView />
    </DataTemplate>
    <DataTemplate DataType="components:DemultiplexerViewModel">
      <componentViews:DemultiplexerView />
    </DataTemplate>
    <DataTemplate DataType="components:DecoderViewModel">
      <componentViews:DecoderView />
    </DataTemplate>
    <DataTemplate DataType="components:PriorityEncoderViewModel">
      <componentViews:PriorityEncoderView />
    </DataTemplate>
    <DataTemplate DataType="components:DFlipFlopViewModel">
      <componentViews:DFlipFlopView />
    </DataTemplate>
    <DataTemplate DataType="components:DLatchViewModel">
      <componentViews:DLatchView />
    </DataTemplate>
    <DataTemplate DataType="components:JKFlipFlopViewModel">
      <componentViews:JKFlipFlopView />
    </DataTemplate>
    <DataTemplate DataType="components:TFlipFlopViewModel">
      <componentViews:TFlipFlopView />
    </DataTemplate>
    <DataTemplate DataType="components:RegisterViewModel">
      <componentViews:RegisterView />
    </DataTemplate>
    <DataTemplate DataType="components:CounterViewModel">
      <componentViews:CounterView />
    </DataTemplate>
    <DataTemplate DataType="components:TristateBufferViewModel">
      <componentViews:TristateBufferView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <StackPanel Margin="8,8" Spacing="4">
      <Border
        Width="100"
        Height="100"
        HorizontalAlignment="Center"
        Margin="0,8"
        ClipToBounds="False"
      >
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" ClipToBounds="False">
          <ContentControl
            Content="{Binding SelectedComponent}"
            Width="{Binding SelectedComponent.Width}"
            Height="{Binding SelectedComponent.Height}"
            ClipToBounds="False"
          />
        </Viewbox>
      </Border>

      <Border Height="1" Background="#3A3A3A" Margin="0,8" />

      <Grid ColumnDefinitions="*,Auto" Margin="4">
        <TextBlock Text="Type" VerticalAlignment="Center" Opacity="0.8" />
        <TextBlock Grid.Column="1" Text="{Binding ComponentType}" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsMultiInputVisible}" Margin="4">
        <TextBlock Text="Input Count" VerticalAlignment="Center" Opacity="0.8" />
        <TextBlock Text="(A/S)" VerticalAlignment="Center" Opacity="0.5" Margin="67,0,0,0" />
        <TextBlock Grid.Column="1" Text="{Binding DynamicPinsCount}" FontSize="12" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" Margin="4">
        <TextBlock Text="Rotation" VerticalAlignment="Center" Opacity="0.8" />
        <TextBlock Text="(R)" VerticalAlignment="Center" Opacity="0.5" Margin="48,0,0,0" />
        <TextBlock Grid.Column="1" Text="{Binding Rotation}" FontSize="12" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsClockVisible}" Margin="4">
        <TextBlock Text="Frequency (Hz)" VerticalAlignment="Center" Opacity="0.8" />
        <TextBox
          Grid.Column="1"
          Text="{Binding FrequencyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          FontSize="12"
        />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" Margin="4" IsVisible="{Binding IsToggleVisible}">
        <TextBlock Text="State" VerticalAlignment="Center" Opacity="0.8" />
        <TextBlock Text="(Space)" VerticalAlignment="Center" Opacity="0.5" Margin="30,0,0,0" />
        <TextBlock Grid.Column="1" Text="{Binding ToggleState}" FontSize="12" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" Margin="4" IsVisible="{Binding IsOutputVisible}">
        <TextBlock Text="Output" VerticalAlignment="Center" Opacity="0.8" />
        <TextBlock Grid.Column="1" Text="{Binding OutputState}" FontSize="12" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" Margin="4" IsVisible="{Binding IsProbeVisible}">
        <TextBlock Text="State" VerticalAlignment="Center" Opacity="0.8" />
        <TextBlock Grid.Column="1" Text="{Binding ProbeState}" FontSize="12" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>

<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:IRis.ViewModels.Main.Canvas.CircuitObjects.Components"
  x:DataType="vm:DLatchViewModel"
  x:Class="IRis.Views.Main.Canvas.CircuitObjects.Components.DLatchView"
  xmlns:core="using:IRis.Views.Main.Canvas.Core"
  ClipToBounds="False"
>
  <Grid ClipToBounds="False">
    <Rectangle Margin="-20,-5,-20,-5" Fill="Transparent" />

    <Border
      Width="{Binding Width}"
      Height="{Binding Height}"
      Background="{DynamicResource ComponentFillBrush}"
      BorderBrush="{DynamicResource ComponentBorderBrush}"
      BorderThickness="2"
      CornerRadius="2"
    >
      <Grid>
        <Grid.Styles>
          <Style Selector="TextBlock">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform">
              <RotateTransform Angle="{Binding TextRotation}" />
            </Setter>
          </Style>
        </Grid.Styles>
        <TextBlock
          Text="D"
          Foreground="{DynamicResource ComponentBorderBrush}"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          FontSize="8"
          Margin="3,3,0,0"
          IsHitTestVisible="False"
        />
        <TextBlock
          Text="En"
          Foreground="{DynamicResource ComponentBorderBrush}"
          HorizontalAlignment="Left"
          VerticalAlignment="Bottom"
          FontSize="8"
          Margin="3,0,0,3"
          IsHitTestVisible="False"
        />
        <TextBlock
          Text="Q"
          Foreground="{DynamicResource ComponentBorderBrush}"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          FontSize="8"
          Margin="0,3,3,0"
          IsHitTestVisible="False"
        />
        <TextBlock
          Text="Q̅"
          Foreground="{DynamicResource ComponentBorderBrush}"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          FontSize="8"
          Margin="0,0,3,3"
          IsHitTestVisible="False"
        />
      </Grid>
    </Border>

    <UniformGrid Columns="1" ClipToBounds="False">
      <Grid ClipToBounds="False">
        <Line
          StartPoint="0,0"
          EndPoint="10,0"
          Stroke="{DynamicResource ComponentBorderBrush}"
          StrokeThickness="2"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Margin="-10,0,0,0"
        />
        <core:TerminalView
          DataContext="{Binding D}"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Margin="-20,0,0,0"
        />
      </Grid>
      <Grid ClipToBounds="False">
        <Line
          StartPoint="0,0"
          EndPoint="10,0"
          Stroke="{DynamicResource ComponentBorderBrush}"
          StrokeThickness="2"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Margin="-10,0,0,0"
        />
        <core:TerminalView
          DataContext="{Binding En}"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Margin="-20,0,0,0"
        />
      </Grid>
    </UniformGrid>

    <UniformGrid Columns="1" ClipToBounds="False" HorizontalAlignment="Right">
      <Grid ClipToBounds="False">
        <Line
          StartPoint="0,0"
          EndPoint="10,0"
          Stroke="{DynamicResource ComponentBorderBrush}"
          StrokeThickness="2"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Margin="0,0,-10,0"
        />
        <core:TerminalView
          DataContext="{Binding Q}"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Margin="0,0,-20,0"
        />
      </Grid>
      <Grid ClipToBounds="False">
        <Line
          StartPoint="0,0"
          EndPoint="10,0"
          Stroke="{DynamicResource ComponentBorderBrush}"
          StrokeThickness="2"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Margin="0,0,-10,0"
        />
        <core:TerminalView
          DataContext="{Binding QBar}"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Margin="0,0,-20,0"
        />
      </Grid>
    </UniformGrid>

    <Rectangle
      Stroke="DodgerBlue"
      StrokeThickness="1"
      Margin="-20,-5,-20,-5"
      IsHitTestVisible="False"
      Opacity="{Binding SelectionOpacity}"
    >
      <Rectangle.Fill>
        <SolidColorBrush Color="#469adf" Opacity="0.2" />
      </Rectangle.Fill>
    </Rectangle>
  </Grid>
</UserControl>

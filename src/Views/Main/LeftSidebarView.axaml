<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="IRis.Views.Main.LeftSidebarView"
  xmlns:vm="using:IRis.ViewModels.Main"
  x:DataType="vm:LeftSidebarViewModel"
  xmlns:views="using:IRis.Views.Main"
  FontSize="12"
>
  <UserControl.Resources>
    <Border
      x:Key="SampleToggle"
      Width="20"
      Height="20"
      Background="{DynamicResource ComponentFillBrush}"
      BorderBrush="{DynamicResource ComponentBorderBrush}"
      BorderThickness="2"
      CornerRadius="1"
    >
      <TextBlock
        Text="0"
        Foreground="{DynamicResource ComponentBorderBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Margin="0,0,0,1"
        FontSize="14"
        FontWeight="ExtraBold"
      />
    </Border>
    <Border
      x:Key="SampleClock"
      Width="20"
      Height="20"
      Background="{DynamicResource ComponentFillBrush}"
      BorderBrush="{DynamicResource ComponentBorderBrush}"
      BorderThickness="2"
      CornerRadius="1"
    >
      <Path
        Data="M0,6 L3,6 L3,0 L9,0 L9,6 L12,6"
        Stroke="{DynamicResource ComponentBorderBrush}"
        StrokeThickness="1.5"
        Stretch="None"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        IsHitTestVisible="False"
      />
    </Border>
    <Border
      x:Key="SampleProbe"
      Width="20"
      Height="20"
      Background="{DynamicResource ComponentFillBrush}"
      BorderBrush="{DynamicResource ComponentBorderBrush}"
      BorderThickness="2"
      CornerRadius="10"
    >
      <TextBlock
        Text="?"
        Foreground="{DynamicResource ComponentBorderBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="14"
        FontWeight="ExtraBold"
        Margin="0,0,0,1"
      />
    </Border>
    <Grid x:Key="SampleAnd" Width="20" Height="20">
      <Path
        Fill="{DynamicResource ComponentFillBrush}"
        Stroke="{DynamicResource ComponentBorderBrush}"
        StrokeThickness="2"
        Stretch="Fill"
        Data="M 0,100 L 60,100 A 40,40 0 0 0 60,0 L 0,0 Z"
      />
    </Grid>
    <Grid x:Key="SampleNot" Width="20" Height="20">
      <Path
        Fill="{DynamicResource ComponentFillBrush}"
        Stroke="{DynamicResource ComponentBorderBrush}"
        StrokeThickness="2"
        Stretch="Fill"
        Data="M 0,0 L 0,100 L 100,50 Z"
        Margin="0,0,6,0"
      />
      <Ellipse
        Width="8"
        Height="8"
        Fill="{DynamicResource ComponentFillBrush}"
        Stroke="{DynamicResource ComponentBorderBrush}"
        StrokeThickness="2"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
      />
    </Grid>
    <Grid x:Key="SampleOr" Width="20" Height="20">
      <Path
        Fill="{DynamicResource ComponentFillBrush}"
        Stroke="{DynamicResource ComponentBorderBrush}"
        StrokeThickness="2"
        Stretch="Fill"
        Data="M 0,0 Q 14,50 0,100 Q 60,95 100,50 Q 60,5 0,0 Z"
      />
    </Grid>
    <Viewbox x:Key="SampleXor" Width="20" Height="20" Stretch="Fill">
      <Canvas Width="114" Height="100">
        <Path
          Stroke="{DynamicResource ComponentBorderBrush}"
          StrokeThickness="10"
          Data="M 0,0 Q 14,50 0,100"
        />
        <Path
          Fill="{DynamicResource ComponentFillBrush}"
          Stroke="{DynamicResource ComponentBorderBrush}"
          StrokeThickness="10"
          Data="M 14,0 Q 28,50 14,100 Q 74,95 114,50 Q 74,5 14,0 Z"
        />
      </Canvas>
    </Viewbox>
    <Grid x:Key="SampleNand" Width="20" Height="20">
      <Path
        Fill="{DynamicResource ComponentFillBrush}"
        Stroke="{DynamicResource ComponentBorderBrush}"
        StrokeThickness="2"
        Stretch="Fill"
        Data="M 0,100 L 60,100 A 40,40 0 0 0 60,0 L 0,0 Z"
        Margin="0,0,4,0"
      />
      <Ellipse
        Width="4"
        Height="4"
        Fill="{DynamicResource ComponentFillBrush}"
        Stroke="{DynamicResource ComponentBorderBrush}"
        StrokeThickness="2"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
      />
    </Grid>
    <Grid x:Key="SampleNor" Width="20" Height="20">
      <Path
        Fill="{DynamicResource ComponentFillBrush}"
        Stroke="{DynamicResource ComponentBorderBrush}"
        StrokeThickness="2"
        Stretch="Fill"
        Data="M 0,0 Q 14,50 0,100 Q 60,95 100,50 Q 60,5 0,0 Z"
        Margin="0,0,4,0"
      />
      <Ellipse
        Width="4"
        Height="4"
        Fill="{DynamicResource ComponentFillBrush}"
        Stroke="{DynamicResource ComponentBorderBrush}"
        StrokeThickness="2"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
      />
    </Grid>
    <Viewbox x:Key="SampleXnor" Width="20" Height="20" Stretch="Fill">
      <Canvas Width="122" Height="100">
        <Path
          Stroke="{DynamicResource ComponentBorderBrush}"
          StrokeThickness="10"
          Data="M 0,0 Q 14,50 0,100"
        />
        <Path
          Fill="{DynamicResource ComponentFillBrush}"
          Stroke="{DynamicResource ComponentBorderBrush}"
          StrokeThickness="10"
          Data="M 14,0 Q 28,50 14,100 Q 74,95 114,50 Q 74,5 14,0 Z"
        />
        <Ellipse
          Canvas.Left="114"
          Canvas.Top="48"
          Width="8"
          Height="8"
          Fill="{DynamicResource ComponentFillBrush}"
          Stroke="{DynamicResource ComponentBorderBrush}"
          StrokeThickness="2"
        />
      </Canvas>
    </Viewbox>
    <Border
      x:Key="SampleFullAdder"
      Width="20"
      Height="20"
      Background="{DynamicResource ComponentFillBrush}"
      BorderBrush="{DynamicResource ComponentBorderBrush}"
      BorderThickness="2"
      CornerRadius="2"
    >
      <TextBlock
        Text="FA"
        Foreground="{DynamicResource ComponentBorderBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="9"
        FontWeight="ExtraBold"
        Margin="1,0,0,0"
      />
    </Border>
    <Border
      x:Key="SampleDLatch"
      Width="20"
      Height="20"
      Background="{DynamicResource ComponentFillBrush}"
      BorderBrush="{DynamicResource ComponentBorderBrush}"
      BorderThickness="2"
      CornerRadius="2"
    >
      <TextBlock
        Text="DL"
        Foreground="{DynamicResource ComponentBorderBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="9"
        FontWeight="ExtraBold"
        Margin="1,0,0,0"
      />
    </Border>
    <Border
      x:Key="SampleDFlipFlop"
      Width="20"
      Height="20"
      Background="{DynamicResource ComponentFillBrush}"
      BorderBrush="{DynamicResource ComponentBorderBrush}"
      BorderThickness="2"
      CornerRadius="2"
    >
      <TextBlock
        Text="D"
        Foreground="{DynamicResource ComponentBorderBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="9"
        FontWeight="ExtraBold"
        Margin="1,0,0,0"
      />
    </Border>
    <Border
      x:Key="SampleJKFlipFlop"
      Width="20"
      Height="20"
      Background="{DynamicResource ComponentFillBrush}"
      BorderBrush="{DynamicResource ComponentBorderBrush}"
      BorderThickness="2"
      CornerRadius="2"
    >
      <TextBlock
        Text="JK"
        Foreground="{DynamicResource ComponentBorderBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="9"
        FontWeight="ExtraBold"
        Margin="1,0,0,0"
      />
    </Border>
    <Border
      x:Key="SampleTFlipFlop"
      Width="20"
      Height="20"
      Background="{DynamicResource ComponentFillBrush}"
      BorderBrush="{DynamicResource ComponentBorderBrush}"
      BorderThickness="2"
      CornerRadius="2"
    >
      <TextBlock
        Text="T"
        Foreground="{DynamicResource ComponentBorderBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="9"
        FontWeight="ExtraBold"
        Margin="1,0,0,0"
      />
    </Border>
    <Border
      x:Key="SampleRegister"
      Width="20"
      Height="20"
      Background="{DynamicResource ComponentFillBrush}"
      BorderBrush="{DynamicResource ComponentBorderBrush}"
      BorderThickness="2"
      CornerRadius="2"
    >
      <TextBlock
        Text="R"
        Foreground="{DynamicResource ComponentBorderBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="9"
        FontWeight="ExtraBold"
        Margin="1,0,0,0"
      />
    </Border>
    <Border
      x:Key="SampleCounter"
      Width="20"
      Height="20"
      Background="{DynamicResource ComponentFillBrush}"
      BorderBrush="{DynamicResource ComponentBorderBrush}"
      BorderThickness="2"
      CornerRadius="2"
    >
      <TextBlock
        Text="CT"
        Foreground="{DynamicResource ComponentBorderBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="8"
        FontWeight="ExtraBold"
        Margin="1,0,0,0"
      />
    </Border>
    <Grid x:Key="SampleMux" Width="16" Height="20">
      <Path
        Fill="{DynamicResource ComponentFillBrush}"
        Stroke="{DynamicResource ComponentBorderBrush}"
        StrokeThickness="2"
        Stretch="Fill"
        Data="M 0,0 L 100,20 L 100,80 L 0,100 Z"
      />
    </Grid>
    <Grid x:Key="SampleDemux" Width="16" Height="20">
      <Path
        Fill="{DynamicResource ComponentFillBrush}"
        Stroke="{DynamicResource ComponentBorderBrush}"
        StrokeThickness="2"
        Stretch="Fill"
        Data="M 0,20 L 100,0 L 100,100 L 0,80 Z"
      />
    </Grid>
    <Border
      x:Key="SampleDecoder"
      Width="16"
      Height="20"
      Background="{DynamicResource ComponentFillBrush}"
      BorderBrush="{DynamicResource ComponentBorderBrush}"
      BorderThickness="2"
      CornerRadius="2"
    >
      <TextBlock
        Text="Dc"
        Foreground="{DynamicResource ComponentBorderBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="8"
        FontWeight="ExtraBold"
      />
    </Border>
    <Border
      x:Key="SamplePriorityEncoder"
      Width="16"
      Height="20"
      Background="{DynamicResource ComponentFillBrush}"
      BorderBrush="{DynamicResource ComponentBorderBrush}"
      BorderThickness="2"
      CornerRadius="2"
    >
      <TextBlock
        Text="Pe"
        Foreground="{DynamicResource ComponentBorderBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="8"
        FontWeight="ExtraBold"
      />
    </Border>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ToggleButton.section">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock
                Text="▾"
                FontSize="16"
                IsVisible="{TemplateBinding IsChecked}"
                VerticalAlignment="Center"
              />
              <TextBlock
                Text="▸"
                FontSize="16"
                IsVisible="{TemplateBinding IsChecked, Converter={x:Static BoolConverters.Not}}"
                VerticalAlignment="Center"
              />
              <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="ToggleButton.section:pointerover /template/ Border">
      <Setter Property="Background" Value="#2A2D2E" />
    </Style>

    <Style Selector="Button.item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="24,0,8,0" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.item:pointerover /template/ Border">
      <Setter Property="Background" Value="#2A2D2E" />
    </Style>
    <Style Selector="Button.item:focus /template/ Border">
      <Setter Property="Background" Value="#37373D" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="15,6" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border
            Background="{TemplateBinding Background}"
            Padding="{TemplateBinding Padding}"
            BorderThickness="{TemplateBinding BorderThickness}"
            BorderBrush="{TemplateBinding BorderBrush}"
          >
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.tab.active /template/ Border">
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="Padding" Value="15,6,15,4" />
      <Setter Property="BorderBrush" Value="DodgerBlue" />
    </Style>
    <Style Selector="Button.tab:pointerover /template/ Border">
      <Setter Property="Background" Value="#2A2D2E" />
    </Style>
  </UserControl.Styles>

  <views:LeftSidebarContent />
</UserControl>

<Application
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="IRis.App"
  xmlns:local="using:IRis"
  xmlns:sty="using:FluentAvalonia.Styling"
  xmlns:vm="using:IRis.ViewModels"
  x:DataType="vm:AppViewModel"
  RequestedThemeVariant="{Binding AppState.Theme}"
>
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <VisualBrush
            x:Key="CanvasGridTileBrush"
            TileMode="Tile"
            SourceRect="0,0,10,10"
            DestinationRect="0,0,10,10"
          >
            <VisualBrush.Visual>
              <Canvas Width="10" Height="10" Background="White">
                <Line StartPoint="0,10" EndPoint="10,10" Stroke="#D3D3D3" StrokeThickness="1" />
                <Line StartPoint="10,0" EndPoint="10,10" Stroke="#D3D3D3" StrokeThickness="1" />
              </Canvas>
            </VisualBrush.Visual>
          </VisualBrush>
          <SolidColorBrush x:Key="ZoomBorderBackground" Color="#F4F4F4" />
          <SolidColorBrush x:Key="ComponentBorderBrush" Color="Black" />
          <SolidColorBrush x:Key="ComponentFillBrush" Color="#F4F4F4" />
          <SolidColorBrush x:Key="WireBrush" Color="Black" />
          <SolidColorBrush x:Key="HighStateBrush" Color="DarkGreen" />
          <SolidColorBrush x:Key="LowStateBrush" Color="DarkRed" />
          <SolidColorBrush x:Key="UnknownStateBrush" Color="#5F5F5F" />
        </ResourceDictionary>
        
        <ResourceDictionary x:Key="Dark">
          <VisualBrush
            x:Key="CanvasGridTileBrush"
            TileMode="Tile"
            SourceRect="0,0,10,10"
            DestinationRect="0,0,10,10"
          >
            <VisualBrush.Visual>
              <Canvas Width="10" Height="10" Background="#121212">
                <Line StartPoint="0,10" EndPoint="10,10" Stroke="#222222" StrokeThickness="1" />
                <Line StartPoint="10,0" EndPoint="10,10" Stroke="#222222" StrokeThickness="1" />
              </Canvas>
            </VisualBrush.Visual>
          </VisualBrush>
          <SolidColorBrush x:Key="ZoomBorderBackground" Color="#050505" />
          <SolidColorBrush x:Key="ComponentBorderBrush" Color="#B6B6B6" />
          <SolidColorBrush x:Key="ComponentFillBrush" Color="#1A1A1A" />
          <SolidColorBrush x:Key="WireBrush" Color="#B6B6B6" />
          <SolidColorBrush x:Key="HighStateBrush" Color="#007D00" />
          <SolidColorBrush x:Key="LowStateBrush" Color="#B60000" />
          <SolidColorBrush x:Key="UnknownStateBrush" Color="#5F5F5F" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <StreamGeometry x:Key="arrow_undo_regular">

<Window 
    Title="Generate From Image"
    Icon="/Assets/avalonia-logo.ico"
    Width="520"
    Height="420"

    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:vm="using:IRis.ViewModels"
    x:DataType="vm:GenerateFromImageWindowViewModel"
    x:Class="IRis.Views.GenerateFromImageWindowView"
>
    <StackPanel Margin="20" Spacing="12">
        <Button
            Content="Select Image..."
            Command="{Binding PickImageCommand}"
            IsEnabled="{Binding CanGenerate}"
            HorizontalAlignment="Left"
        />
        <Border Height="280" BorderBrush="Gray" BorderThickness="1">
            <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
        </Border>
        <Button
            Content="Generate"
            Command="{Binding GenerateCommand}"
            HorizontalAlignment="Right"
        />
    </StackPanel>
</Window>

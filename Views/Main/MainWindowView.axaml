<Window 
    Title="IRis"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:FluentAvalonia.UI.Controls"

    xmlns:v="using:IRis.Views.Main"
    xmlns:vm="using:IRis.ViewModels.Main"
    x:Class="IRis.Views.Main.MainWindowView"
    x:DataType="vm:MainWindowViewModel"
>
    <DockPanel>
        <v:TopMenuView DockPanel.Dock="Top" />
        <v:LeftSidebarView DockPanel.Dock="Left" />
        <v:TopToolbarView DockPanel.Dock="Top" />
        <v:BottomStatusBarView DockPanel.Dock="Bottom" />
        <v:MainCanvasView />
    </DockPanel>

    <Window.KeyBindings>
        <KeyBinding Gesture="Delete" Command="{Binding DeleteKeyCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding EscapeKeyCommand}" />
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyKeyCommand}" />
        <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteKeyCommand}" />
        <KeyBinding Gesture="R" Command="{Binding RotateKeyCommand}" />
        <KeyBinding Gesture="A" Command="{Binding AddInputKeyCommand}" />
        <KeyBinding Gesture="S" Command="{Binding RemoveInputKeyCommand}" />
    </Window.KeyBindings>
</Window>

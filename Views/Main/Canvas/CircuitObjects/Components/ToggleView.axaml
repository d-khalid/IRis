<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:vm="using:IRis.ViewModels.Main.Canvas.CircuitObjects.Components"
    x:DataType="vm:ToggleViewModel"
    x:Class="IRis.Views.Main.Canvas.CircuitObjects.Components.ToggleView"

    xmlns:core="using:IRis.Views.Main.Canvas.Core"
    ClipToBounds="False"
>
    <Grid ClipToBounds="False">
        <Border
            Width="{Binding Width}"
            Height="{Binding Height}"
            Background="White"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="1"
        />

        <TextBlock 
            Text="0"
            Foreground="Black"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            FontWeight="Bold"
            IsHitTestVisible="False"
        />

        <Line
            StartPoint="0,0"
            EndPoint="10,0"
            Stroke="Black"
            StrokeThickness="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,-10,0"
        />
        <core:TerminalView
            DataContext="{Binding Output}"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,-20,0"
        />

        <Rectangle
            Stroke="DodgerBlue"
            StrokeThickness="1"
            IsVisible="{Binding IsSelected}"
            Margin="-20,-5"
            IsHitTestVisible="False"
            Opacity="{Binding SelectionOpacity}"
        >
            <Rectangle.Fill>
                <SolidColorBrush Color="#469adf" Opacity="0.2" />
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>

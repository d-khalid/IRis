<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:vm="using:IRis.ViewModels.Main.Canvas.CircuitObjects.Components.Gates"
    x:DataType="vm:NandGateViewModel"
    x:Class="IRis.Views.Main.Canvas.CircuitObjects.Components.Gates.NandGateView"

    ClipToBounds="False"
>
    <Grid ClipToBounds="False">
        <Path
            Fill="{DynamicResource ComponentFillBrush}" 
            Stroke="{DynamicResource ComponentBorderBrush}" 
            StrokeThickness="2"
            Stretch="Fill"
            Data="M 0,100 L 60,100 A 40,40 0 0 0 60,0 L 0,0 Z"
            Margin="0,0,8,0"
        />
        <Ellipse
            Width="8"
            Height="8"
            Fill="{DynamicResource ComponentFillBrush}"
            Stroke="{DynamicResource ComponentBorderBrush}"
            StrokeThickness="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
        />
    </Grid>
</UserControl>

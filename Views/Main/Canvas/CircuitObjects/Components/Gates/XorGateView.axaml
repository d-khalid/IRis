<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:vm="using:IRis.ViewModels.Main.Canvas.CircuitObjects.Components.Gates"
    x:DataType="vm:XorGateViewModel"
    x:Class="IRis.Views.Main.Canvas.CircuitObjects.Components.Gates.XorGateView"

    xmlns:core="using:IRis.Views.Main.Canvas.Core"
    ClipToBounds="False"
>
    <Grid ClipToBounds="False">
        <Path
            Stroke="{DynamicResource ComponentBorderBrush}"
            StrokeThickness="2"
            Stretch="Fill"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Width="14"
            Margin="-6,0,0,0"
            Data="M 14,0 Q 0,50 14,100" 
        />
        <Path
            Fill="{DynamicResource ComponentFillBrush}" 
            Stroke="{DynamicResource ComponentBorderBrush}" 
            StrokeThickness="2"
            Stretch="Fill"
            Data="M 0,0 Q 14,50 0,100 Q 60,95 100,50 Q 60,5 0,0 Z" 
        />
    </Grid>
</UserControl>

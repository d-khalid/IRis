<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:vm="using:IRis.ViewModels.Main.Canvas.CircuitObjects.Components"
    x:DataType="vm:GateViewModel"
    x:Class="IRis.Views.Main.Canvas.CircuitObjects.Components.GateView"

    xmlns:gates="using:IRis.ViewModels.Main.Canvas.CircuitObjects.Components.Gates"
    xmlns:views="using:IRis.Views.Main.Canvas.CircuitObjects.Components.Gates"
    ClipToBounds="False"
>
    <UserControl.DataTemplates>
        <DataTemplate DataType="gates:MultiInputGateViewModel">
            <views:MultiInputGateView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ClipToBounds="False">
        <ContentControl Content="{Binding}" ClipToBounds="False" />

        <Rectangle
            Stroke="DodgerBlue"
            StrokeThickness="1"
            IsVisible="{Binding IsSelected}" 
            Margin="-20,-5"
            IsHitTestVisible="False"
            Opacity="{Binding SelectionOpacity}"
        >
            <Rectangle.Fill>
                <SolidColorBrush Color="#469adf" Opacity="0.2" />
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>

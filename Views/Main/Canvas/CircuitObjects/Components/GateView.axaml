<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:vm="using:IRis.ViewModels.Main.Canvas.CircuitObjects.Components"
    x:DataType="vm:GateViewModel"
    x:Class="IRis.Views.Main.Canvas.CircuitObjects.Components.GateView"

    xmlns:gates="using:IRis.ViewModels.Main.Canvas.CircuitObjects.Components.Gates"
    xmlns:views="using:IRis.Views.Main.Canvas.CircuitObjects.Components.Gates"
>
    <DataTemplate DataType="gates:AndGateViewModel">
        <views:AndGateView />
    </DataTemplate>
</UserControl>

<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:vm="using:IRis.ViewModels.Main.Canvas.Core"
    x:DataType="vm:TerminalViewModel"
    x:Class="IRis.Views.Main.Canvas.Core.TerminalView"
>
    <Grid ClipToBounds="False">
        <Ellipse
            PointerPressed="OnPointerPressed"
            Width="10" 
            Height="10"
            Fill="DarkGreen"
            Margin="-15,0,0,0"
            Cursor="Cross"
        />
    </Grid>
</UserControl>

<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="IRis.Views.Main.TopToolbarView"

    xmlns:vm="using:IRis.ViewModels"
    x:DataType="vm:TopToolbarViewModel"
>
    <DockPanel Margin="5">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="5">
            <Button Content="Toggle Switch" />
            <Button Content="Logic Probe" />
            <Button Content="D Latch" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
            <Button
                HorizontalAlignment="Right"
                Content="{Binding SimulationToggleContent}"
                Command="{Binding SimulationToggleCommand}"
                Background="{Binding SimulationToggleBackground}"
                Margin="5,0"
            />
        </StackPanel>
    </DockPanel>
</UserControl>

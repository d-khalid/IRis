<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="IRis.Views.Main.TopToolbarView"
>
    <Border Padding="5">
        <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="5">
                <Button Content="Toggle Switch" Click="OnToggleClick" />
                <Button Content="Logic Probe" Click="OnProbeClick" />
                <Button Content="D Latch" Click="OnDLatchClick" />
            </StackPanel>
            <Button 
                x:Name="SimulationToggle"
                HorizontalAlignment="Right"
                Content="Simulation: OFF"
                Click="OnSimulationToggleClick"
                Background="DarkRed"
                Margin="10,0"
            />
        </Grid>
    </Border>
</UserControl>

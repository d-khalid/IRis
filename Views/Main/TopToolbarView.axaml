<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="IRis.Views.Main.TopToolbarView"

    xmlns:vm="using:IRis.ViewModels.Main"
    x:DataType="vm:TopToolbarViewModel"
>
    <DockPanel Margin="5,5">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="5">
            <Button MaxWidth="28" MaxHeight="32">
                <PathIcon Data="{StaticResource arrow_undo_regular}" Width="9" Height="9" />
            </Button>
            <Button MaxWidth="28" MaxHeight="32">
                <PathIcon Data="{StaticResource arrow_redo_regular}" Width="9" Height="9" />
            </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
            <Button
                HorizontalAlignment="Right"
                Command="{Binding SimulationToggleCommand}"
                Background="{Binding SimulationToggleBackground}"
                Content="{Binding SimulationToggleContent}"
                FontSize="12"
                BorderThickness="0"
            />
        </StackPanel>
    </DockPanel>
</UserControl>

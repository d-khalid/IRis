<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IRis.ViewModels"
        xmlns:core="using:IRis.Models.Core"
        xmlns:comp="using:IRis.Models.Components"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"

        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="IRis.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="IRis">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    
    
    <!-- XAML Constants, they are used automatically if you do "Classes=gate" in a Control -->
    <Window.Styles>
        <Style Selector="Path.gate">
            <Setter Property="Fill" Value="White" />
            <Setter Property="Stroke" Value="Black" />
            <Setter Property="StrokeThickness" Value="4" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding
            Gesture="{Binding KeyConfig.Entries[SaveFile]}"
            Command="{Binding SaveCommand}" />
        <KeyBinding
            Gesture="{Binding KeyConfig.Entries[OpenFile]}"
            Command="{Binding OpenCommand}" />
        <KeyBinding
            Gesture="{Binding KeyConfig.Entries[NewFile]}"
            Command="{Binding NewCommand}" />
        <KeyBinding
            Gesture="{Binding KeyConfig.Entries[Delete]}"
            Command="{Binding DeleteCommand}" />
        <KeyBinding
            Gesture="{Binding KeyConfig.Entries[Unselect]}"
            Command="{Binding AddComponentCommand}"
            CommandParameter="NULL" />
        <KeyBinding
            Gesture="{Binding KeyConfig.Entries[OtherComponents]}"
            Command="{Binding OtherComponentsCommand}" />
        <KeyBinding
            Gesture="{Binding KeyConfig.Entries[Copy]}"
            Command="{Binding CopyCommand}" />
        <KeyBinding
            Gesture="{Binding KeyConfig.Entries[Cut]}"
            Command="{Binding CutCommand}" />
        <KeyBinding
            Gesture="{Binding KeyConfig.Entries[Paste]}"
            Command="{Binding PasteCommand}" />
        <KeyBinding
            Gesture="{Binding KeyConfig.Entries[Undo]}"
            Command="{Binding UndoCommand}" />
        <KeyBinding
            Gesture="{Binding KeyConfig.Entries[Redo]}"
            Command="{Binding RedoCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem
                    Header="New"
                    Command="{Binding NewCommand}"
                    InputGesture="{Binding KeyConfig.Entries[NewFile]}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource new_regular}" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem
                    Header="Open..."
                    Command="{Binding OpenCommand}"
                    InputGesture="{Binding KeyConfig.Entries[OpenFile]}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource open_regular}" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem
                    Header="Save"
                    Command="{Binding SaveCommand}"
                    InputGesture="{Binding KeyConfig.Entries[SaveFile]}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource save_regular}" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}" />

                <Separator />

                <MenuItem Header="Export">
                    <MenuFlyout>
                        <MenuItem Header="Component" Command="{Binding ExportComponentCommand}" />
                        <MenuItem Header="Circuit" Command="{Binding ExportCircuitCommand}" />
                    </MenuFlyout>
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource arrow_export_rtl_regular}" />
                    </MenuItem.Icon>
                </MenuItem>

                <Separator />

                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </MenuItem>

            <MenuItem Header="Edit">
                <MenuItem Header="Undo"
                          Command="{Binding UndoCommand}"
                          InputGesture="{Binding KeyConfig.Entries[Undo]}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource arrow_undo_regular}" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Redo"
                          Command="{Binding RedoCommand}"
                          InputGesture="{Binding KeyConfig.Entries[Redo]}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource arrow_redo_regular}" />
                    </MenuItem.Icon>
                </MenuItem>

                <Separator />

                <MenuItem Header="Cut"
                          Command="{Binding CutCommand}"
                          InputGesture="{Binding KeyConfig.Entries[Cut]}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource cut_regular}" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Copy"
                          Command="{Binding CopyCommand}"
                          InputGesture="{Binding KeyConfig.Entries[Copy]}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource copy_regular}" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Paste"
                          Command="{Binding PasteCommand}"
                          InputGesture="{Binding KeyConfig.Entries[Paste]}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource clipboard_paste_regular}" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Delete"
                          Command="{Binding DeleteCommand}"
                          InputGesture="{Binding KeyConfig.Entries[Delete]}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource delete_regular}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="AI">
                <MenuItem
                    Header="Generate From Prompt"
                    Command="{Binding AiPromptCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource star_emphasis_regular}" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem
                    Header="Generate From Image"
                    Command="{Binding AiImageCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource image_regular}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Help">
                <MenuItem Header="About" Command="{Binding AboutCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource question_regular}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Left Sidebar with Components -->
        <ScrollViewer DockPanel.Dock="Left" Width="150" BorderThickness="2">
            <StackPanel Margin="5" Spacing="5">
                <TextBlock Text="Components" FontWeight="Bold" Margin="0,5" />

                <Button Content="AND Gate" Command="{Binding AddComponentCommand}" CommandParameter="AND" />
                <Button Content="OR Gate" Command="{Binding AddComponentCommand}" CommandParameter="OR" />
                <Button Content="NOT Gate" Command="{Binding AddComponentCommand}" CommandParameter="NOT" />
                <Button Content="NAND Gate" Command="{Binding AddComponentCommand}" CommandParameter="NAND" />
                <Button Content="NOR Gate" Command="{Binding AddComponentCommand}" CommandParameter="NOR" />
                <Button Content="XOR Gate" Command="{Binding AddComponentCommand}" CommandParameter="XOR" />
                <Button Content="XNOR Gate" Command="{Binding AddComponentCommand}" CommandParameter="XNOR" />
                <Button Content="Other" Command="{Binding OtherComponentsCommand}" />

                <TextBlock Text="Input/Output" FontWeight="Bold" Margin="0,10,0,5" />

                <Button Content="Toggle Switch" Command="{Binding AddComponentCommand}" CommandParameter="TOGGLE" />
                <Button Content="Logic Probe" Command="{Binding AddComponentCommand}" CommandParameter="PROBE" />

                <TextBlock Text="Connectors" FontWeight="Bold" Margin="0,10,0,5" />

                <Button Content="Wire" Command="{Binding AddComponentCommand}" CommandParameter="WIRE" />
            </StackPanel>
        </ScrollViewer>

        <!-- Top Toolbar (the one bellow menu) -->
        <Border DockPanel.Dock="Top" Padding="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding SimulationToggleText}"
                        Command="{Binding SimulationToggleCommand}"
                        Background="{Binding SimulationToggleColor}"
                        Margin="5,0" />
            </StackPanel>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Background="DarkSlateGray" Height="30" DockPanel.Dock="Bottom" Padding="5">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="File Name: " />
                    <TextBlock Text="{Binding OpenedFileName}" Margin="5,0" />
                    <TextBlock Text="|" Margin="5,0" />
                    <TextBlock Text="Cursor: " />
                    <TextBlock Text="{Binding CursorPosition}" Margin="2,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Last Action: " />
                    <TextBlock Text="{Binding LastAction}" Margin="2,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Simulation.Components}"
                          Background="LightGray"
                          MinWidth="2000"
                          MinHeight="2000">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ContextFlyout>
                    <MenuFlyout>
                        <MenuItem Header="Copy"
                                  Command="{Binding CopyCommand}"
                                  InputGesture="{Binding KeyConfig.Entries[Copy]}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource copy_regular}" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Cut"
                                  Command="{Binding CutCommand}"
                                  InputGesture="{Binding KeyConfig.Entries[Cut]}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource cut_regular}" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Paste"
                                  Command="{Binding PasteCommand}"
                                  InputGesture="{Binding KeyConfig.Entries[Paste]}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource clipboard_paste_regular}" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Delete"
                                  Command="{Binding DeleteCommand}"
                                  InputGesture="{Binding KeyConfig.Entries[Delete]}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource delete_regular}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </ItemsControl.ContextFlyout>


                <!-- DataTemplates do the drawing, while Style handles things like position which are relative to the Canvas -->
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="core:CircuitObject">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.Styles>
                

                
                <!-- Wire Drawing, Drawing the Terminals adds inner data templating  -->
                <ItemsControl.DataTemplates>
                    
                    <DataTemplate DataType="{x:Type core:Wire}">
                    <Canvas>

                        <Polyline Points="{Binding Points}"
                                  StrokeThickness="2"
                                  Classes.preview="{Binding IsPreview}"
                                  Classes.invalid="{Binding !IsValid}">

                            <Polyline.Styles>
                                <Style Selector="Polyline">
                                    <Setter Property="Stroke" Value="Blue" />
                                </Style>

                                <Style Selector="Polyline.preview">
                                    <Setter Property="Stroke" Value="LightBlue" />
                                </Style>

                                <Style Selector="Polyline.invalid">
                                    <Setter Property="Stroke" Value="Red" />
                                </Style>
                            </Polyline.Styles>
                        </Polyline>

                        <ItemsControl ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <!-- TODO: THIS IS UGLY BECAUSE OF XAML SCOPING; COULD BE IMPROVED BY KEEPING WIRE REFERENCEIN TERMINAL -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="8" Height="8"
                                             Margin="-4,-4,0,0"
                                             Canvas.Left="{Binding Terminal.Position.X}"
                                             Canvas.Top="{Binding Terminal.Position.Y}"
                                             
                                             Classes.preview="{Binding $parent[ItemsControl].((core:Wire)DataContext).IsPreview}"
                                             Classes.invalid="{Binding !$parent[ItemsControl].((core:Wire)DataContext).IsValid}">

                                        <Ellipse.Styles>
                                            <Style Selector="Ellipse">
                                                <Setter Property="Fill" Value="DarkBlue" />
                                            </Style>
                                            <Style Selector="Ellipse.preview">
                                                <Setter Property="Fill" Value="LightGray" />
                                            </Style>
                                            <Style Selector="Ellipse.invalid">
                                                <Setter Property="Fill" Value="Red" />
                                            </Style>
                                        </Ellipse.Styles>
                                    </Ellipse>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </Canvas>
                </DataTemplate>
                    
                    <DataTemplate DataType="{x:Type comp:OrGate}">
                        <Grid Width="{Binding Size.Width}" Height="{Binding Size.Height}">
        
                            <Grid.RenderTransform>
                                <RotateTransform Angle="{Binding Rotation}" />
                            </Grid.RenderTransform>
                            
                            <ItemsControl ItemsSource="{Binding Inputs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:Terminal">
                                        <Canvas Canvas.Left="{Binding Position.X}" Canvas.Top="{Binding Position.Y}">
                                            <Line StartPoint="0,0" 
                                                   EndPoint="{x:Static core:Constants.InputWireEndPoint}" 
                                                   Stroke="Black" 
                                                   StrokeThickness="2" />
                        <ContentControl Content="{Binding Output}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <Canvas Canvas.Left="{Binding Position.X}" Canvas.Top="{Binding Position.Y}">
                                            <Line StartPoint="0,0" 
                                                  EndPoint="{x:Static core:Constants.OutputWireEndPoint}" 
                                                  Stroke="Black" 
                                                  StrokeThickness="2" />
                        
                                            <Ellipse Width="8" Height="8" Margin="-4,-4,0,0" Fill="DarkBlue" />
                                        </Canvas>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                                            <Ellipse Width="8" Height="8" Margin="-4,-4,0,0" Fill="DarkBlue" />
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ContentControl Content="{Binding Output}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="core:Terminal">
                                        <Canvas Canvas.Left="{Binding Position.X}" Canvas.Top="{Binding Position.Y}">
                                            <Line StartPoint="0,0" 
                                                  EndPoint="{x:Static core:Constants.OutputWireEndPoint}" 
                                                  Stroke="Black" 
                                                  StrokeThickness="2" />
                        
                                            <Ellipse Width="8" Height="8" Margin="-4,-4,0,0" Fill="DarkBlue" />
                                        </Canvas>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
        
                        
                            <Path Classes="gate"
                                  Data="M 0,0 A 10,30 0 0 1 0,60 A 60,30 0 0 0 60,30 A 60,30 0 0 0 0,0 Z" />

                            <Rectangle Classes.unselected="{Binding !IsSelected}">
                                <Rectangle.Styles>
                                    <Style Selector="Rectangle">
                                        <Setter Property="Fill" Value="Transparent" />
                                    </Style>
                
                                    <Style Selector="Rectangle.unselected">
                                        <Setter Property="Fill" Value="DodgerBlue" /> 
                                        <Setter Property="Opacity" Value="0.2" />
                                    </Style>
                                </Rectangle.Styles>
                            </Rectangle>
        
                        </Grid>
                    </DataTemplate>
                    
                    
                </ItemsControl.DataTemplates>
                
                

            </ItemsControl>
        </ScrollViewer>

        <!-- ~1~ Main Canvas Area @1@ -->
        <!-- <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"> -->
        <!--     <Canvas x:Name="MainCanvas" Background="LightGray" MinWidth="2000" MinHeight="2000"> -->
        <!--         ~1~ Circuit elements will be added here programmatically @1@ -->
        <!--          -->
        <!-- -->
        <!--         ~1~ Context Menu Setup @1@ -->
        <!--         <Canvas.ContextFlyout> -->
        <!--             <MenuFlyout> -->
        <!--                 <MenuItem Header="Copy" -->
        <!--                           Command="{Binding CopyCommand}" -->
        <!--                           InputGesture="{Binding KeyConfig.Entries[Copy]}"> -->
        <!--                     <MenuItem.Icon> -->
        <!--                         <PathIcon Data="{StaticResource copy_regular}" /> -->
        <!--                     </MenuItem.Icon> -->
        <!--                 </MenuItem> -->
        <!-- -->
        <!--                 <MenuItem Header="Cut" -->
        <!--                           Command="{Binding CutCommand}" -->
        <!--                           InputGesture="{Binding KeyConfig.Entries[Cut]}"> -->
        <!--                     <MenuItem.Icon> -->
        <!--                         <PathIcon Data="{StaticResource cut_regular}" /> -->
        <!--                     </MenuItem.Icon> -->
        <!--                 </MenuItem> -->
        <!--                  -->
        <!--                 <MenuItem Header="Paste" -->
        <!--                           Command="{Binding PasteCommand}" -->
        <!--                           InputGesture="{Binding KeyConfig.Entries[Paste]}"> -->
        <!--                     <MenuItem.Icon> -->
        <!--                         <PathIcon Data="{StaticResource clipboard_paste_regular}" /> -->
        <!--                     </MenuItem.Icon> -->
        <!--                 </MenuItem> -->
        <!--                  -->
        <!--                 <MenuItem Header="Delete" -->
        <!--                           Command="{Binding DeleteCommand}" -->
        <!--                           InputGesture="{Binding KeyConfig.Entries[Delete]}"> -->
        <!--                     <MenuItem.Icon> -->
        <!--                         <PathIcon Data="{StaticResource delete_regular}" /> -->
        <!--                     </MenuItem.Icon> -->
        <!--                 </MenuItem> -->
        <!--             </MenuFlyout> -->
        <!--         </Canvas.ContextFlyout> -->
        <!--     </Canvas> -->
        <!-- </ScrollViewer> -->
    </DockPanel>
</Window>
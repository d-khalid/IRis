<Window 
    Title="IRis"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:FluentAvalonia.UI.Controls"

    xmlns:v="using:IRis.Views.Main"
    xmlns:vm="using:IRis.ViewModels.Main"
    x:Class="IRis.Views.Main.MainWindow"
    x:DataType="vm:MainWindowViewModel"

    xmlns:gates="using:IRis.ViewModels.CircuitObjects.Components.Gates"
    xmlns:circuitobjects="using:IRis.ViewModels.CircuitObjects"
>
    <DockPanel>
        <v:TopMenuView DockPanel.Dock="Top" />

        <!-- left sidebar (component adding buttons) -->
        <ScrollViewer DockPanel.Dock="Left" Width="150" BorderThickness="2">
            <StackPanel Margin="15,0" Spacing="5">
                <TextBlock Text="Components" FontSize="18" FontWeight="Bold" Margin="0,6" />

                <Button Content="AND Gate" Click="OnAddAndClick" />
                <Button Content="OR Gate" Click="OnAddOrClick" />
                <Button Content="NOT Gate" Click="OnAddNotClick" />
                <Button Content="NAND Gate" Click="OnAddNandClick" />
                <Button Content="NOR Gate" Click="OnAddNorClick" />
                <Button Content="XOR Gate" Click="OnAddXorClick" />
                <Button Content="XNOR Gate" Click="OnAddXnorClick" />
                <Button Content="Other" Click="OnAddOtherComponentClick" />
            </StackPanel>
        </ScrollViewer>


        <!-- top toolbar (the one bellow menu) -->
        <Border DockPanel.Dock="Top" Padding="5">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="5">
                    <Button Content="Toggle Switch" Click="OnAddToggleClick" />
                    <Button Content="Logic Probe" Click="OnAddProbeClick" />
                    <Button Content="D Latch" Click="OnAddDLatchClick" />
                    <Button Content="Wire" Click="OnAddWireClick" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Content="Simulation: OFF"
                        Click="OnSimulationToggleClick"
                        Background="DarkRed" />
            </Grid>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Background="DarkSlateGray" Height="30" DockPanel.Dock="Bottom" Padding="5">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Margin="10,0">
                        <TextBlock.Text>
                            <!-- <MultiBinding StringFormat="Cursor: ({0}, {1})">
                                <Binding Path="Simulation.CurrentMousePos.X" />
                                <Binding Path="Simulation.CurrentMousePos.Y" />
                            </MultiBinding> -->
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CircuitObjects}">

                <!-- Context Menu -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas x:Name="MainCanvas" Background="LightGray" MinWidth="2000" MinHeight="2000">
                            <Canvas.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="Copy"
                                            Click="OnContextMenuCopyClick">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource copy_regular}" />
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <MenuItem Header="Cut"
                                            Click="OnContextMenuCutClick">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource cut_regular}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    
                                    <MenuItem Header="Paste"
                                            Click="OnContextMenuPasteClick">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource clipboard_paste_regular}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    
                                    <MenuItem Header="Delete"
                                            Click="OnContextMenuDeleteClick">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource delete_regular}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Canvas.ContextFlyout>
                        </Canvas>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- Binding X,Y coord of components -->
                <ItemsControl.Styles>
                    <Style 
                        Selector="ItemsControl > ContentPresenter" 
                        x:DataType="circuitobjects:ComponentViewModel"
                    >
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.Styles>

                <!-- Component drawing is here -->
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="{x:Type gates:AndGateViewModel}">
                        <Thumb DragDelta="OnComponentDragDelta" Background="Transparent" BorderThickness="0">
                            <Thumb.Template>
                                <ControlTemplate>
                                    
                                    <!-- The visual representation of the AND Gate -->
                                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                                        <Path Data="M 0,0 L 30,0 A 30,30 0 0,1 30,60 L 0,60 Z" 
                                            Fill="White" 
                                            Stroke="Black" 
                                            StrokeThickness="4"/>
                                    </Grid>
                                    
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

    <Window.KeyBindings>
    <!-- Will add key binds here -->
    </Window.KeyBindings>
</Window>


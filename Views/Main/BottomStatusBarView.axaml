<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:IRis.ViewModels.Main"

    x:DataType="vm:BottomStatusBarViewModel"
    x:Class="IRis.Views.Main.BottomStatusBarView"
>
    <Border Background="DarkSlateGray" Height="25">
        <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Margin="10,0" FontSize="12">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Cursor: ({0}, {1})">
                            <Binding Path="Simulation.CurrentMousePos.X" />
                            <Binding Path="Simulation.CurrentMousePos.Y" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

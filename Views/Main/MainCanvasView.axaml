<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:IRis.ViewModels.Main"
    x:DataType="vm:MainCanvasViewModel"
    x:Class="IRis.Views.Main.MainCanvasView"

    xmlns:circuitobjects="using:IRis.ViewModels.Circuit.CircuitObjects"
>
    <UserControl.DataTemplates>
        <DataTemplate DataType="circuitobjects:ComponentViewModel">
            <Border Background="SteelBlue" 
                    BorderBrush="Black" 
                    BorderThickness="2"
                    Width="{Binding Width}" 
                    Height="{Binding Height}"
                    CornerRadius="3">
                <TextBlock Text="AND SHIT" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Foreground="White" 
                           FontWeight="Bold"/>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Canvas 
            x:Name="MainCanvas"
            Background="LightGray" 
            MinWidth="2000" 
            MinHeight="2000"
            PointerPressed="OnPointerPressed"
            PointerMoved="OnPointerMoved"
        >
            <Canvas.Background>
                <VisualBrush TileMode="Tile" SourceRect="0,0,10,10" DestinationRect="0,0,10,10">
                    <VisualBrush.Visual>
                        <Canvas Width="10" Height="10" Background="#F0F0F0">
                            <Line StartPoint="0,10" EndPoint="10,10" Stroke="#D3D3D3" StrokeThickness="1"/>
                            <Line StartPoint="10,0" EndPoint="10,10" Stroke="#D3D3D3" StrokeThickness="1"/>
                        </Canvas>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Canvas.Background>

            <Canvas.ContextFlyout>
                <MenuFlyout>
                    <MenuItem Header="Copy" Click="OnCopyClick">
                        <MenuItem.Icon><PathIcon Data="{StaticResource copy_regular}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Cut" Click="OnCutClick">
                        <MenuItem.Icon><PathIcon Data="{StaticResource cut_regular}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Paste" Click="OnPasteClick">
                        <MenuItem.Icon><PathIcon Data="{StaticResource clipboard_paste_regular}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Delete" Click="OnDeleteClick">
                        <MenuItem.Icon><PathIcon Data="{StaticResource delete_regular}" /></MenuItem.Icon>
                    </MenuItem>
                </MenuFlyout>
            </Canvas.ContextFlyout>

            <ItemsControl ItemsSource="{Binding Simulation.Components}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style Selector="ContentPresenter" x:DataType="circuitobjects:ComponentViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        <Setter Property="Opacity" Value="{Binding Opacity}" />
                    </Style>
                </ItemsControl.Styles>
            </ItemsControl>

            <!-- Setup X and Y of preview -->
            <ContentControl 
                Content="{Binding Simulation.Preview}"
                x:CompileBindings="False"
                Canvas.Left="{Binding Simulation.Preview.X}"
                Canvas.Top="{Binding Simulation.Preview.Y}"
                IsHitTestVisible="False"
            />
        </Canvas>
    </ScrollViewer>
</UserControl>

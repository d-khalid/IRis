<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:paz="using:Avalonia.Controls.PanAndZoom"

    xmlns:vm="using:IRis.ViewModels.Main"
    x:DataType="vm:MainCanvasViewModel"
    x:Class="IRis.Views.Main.MainCanvasView"
    xmlns:circuitobjects="using:IRis.ViewModels.Circuit.CircuitObjects"
    xmlns:core="using:IRis.ViewModels.Circuit.CircuitObjects.Core"
    xmlns:gates="using:IRis.ViewModels.Circuit.CircuitObjects.Components.Gates"
>
    <UserControl.DataTemplates>
        <DataTemplate DataType="gates:AndGateViewModel">
            <Grid
                PointerPressed="OnCircuitObjectPointerPressed"
                PointerReleased="OnCircuitObjectPointerReleased"
                PointerEntered="OnCircuitObjectPointerEntered"
                PointerExited="OnCircuitObjectPointerExited"
                Canvas.Left="{Binding X}"
                Canvas.Top="{Binding Y}"
                Width="{Binding Width}"
                Height="{Binding Height}" 
                Opacity="{Binding Opacity}"
                RenderTransformOrigin="50%,50%"
            >
                <Grid.RenderTransform>
                    <RotateTransform Angle="{Binding Rotation}" />
                </Grid.RenderTransform>

                <Rectangle
                    Margin="-20,-5"
                    Fill="Transparent"
                />

                <ItemsControl ItemsSource="{Binding Inputs}" ClipToBounds="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid 
                                ClipToBounds="False"
                            >
                                <Line 
                                    StartPoint="0,0" 
                                    EndPoint="10,0" 
                                    Stroke="Black" 
                                    StrokeThickness="2" 
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="-10,0,0,0"
                                />
                                <Ellipse 
                                    PointerPressed="OnTerminalPointerPressed"
                                    PointerEntered="OnTerminalPointerEntered"
                                    PointerExited="OnTerminalPointerExited"
                                    Width="10" 
                                    Height="10"
                                    Fill="DarkGreen"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="-15,0,0,0"
                                    Cursor="Cross"
                                />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ClipToBounds="False">
                    <Line 
                        StartPoint="0,0" 
                        EndPoint="10,0" 
                        Stroke="Black" 
                        StrokeThickness="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,-10,0"
                    />
                    <Ellipse 
                        DataContext="{Binding Output}"
                        PointerPressed="OnTerminalPointerPressed"
                        PointerEntered="OnTerminalPointerEntered"
                        PointerExited="OnTerminalPointerExited"
                        Width="10"
                        Height="10"
                        Fill="DarkGreen" 
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,-15,0"
                        Cursor="Cross"
                    />
                </Grid>

                <Path
                    Fill="White" 
                    Stroke="Black" 
                    StrokeThickness="2"
                    Stretch="Fill"
                    Data="M 0,100 L 60,100 A 40,40 0 0 0 60,0 L 0,0 Z" 
                />

                <Rectangle
                    Stroke="DodgerBlue"
                    StrokeThickness="1" 
                    IsVisible="{Binding IsSelected}" 
                    Margin="-20,-5"
                    IsHitTestVisible="False"
                    Opacity="{Binding SelectionOpacity}"
                >
                    <Rectangle.Fill>
                        <SolidColorBrush Color="#469adf" Opacity="0.2" />
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="circuitobjects:WireViewModel">
            <Grid Canvas.Left="0" Canvas.Top="0" ClipToBounds="False">
                <Polyline 
                    Points="{Binding Points}" 
                    Stroke="Black" 
                    StrokeThickness="2"
                    StrokeJoin="Round"
                    StrokeLineCap="Round"
                />
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <paz:ZoomBorder 
        Name="ZoomBorder" 
        Stretch="None" 
        ZoomSpeed="1.2"
        Background="SlateBlue" 
        ClipToBounds="True" 
        Focusable="True"
        VerticalAlignment="Stretch" 
        HorizontalAlignment="Stretch"
        PanButton="Left"
    >
        <Canvas 
            x:Name="MainCanvas"
            Background="LightGray" 
            MinWidth="2000" 
            MinHeight="2000"
            PointerPressed="OnPointerPressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased"
            PointerEntered="OnPointerEntered"
            PointerExited="OnPointerExited"
        >
            <Canvas.Background>
                <VisualBrush TileMode="Tile" SourceRect="0,0,10,10" DestinationRect="0,0,10,10">
                    <VisualBrush.Visual>
                        <Canvas Width="10" Height="10" Background="#F0F0F0">
                            <Line StartPoint="0,10" EndPoint="10,10" Stroke="#D3D3D3" StrokeThickness="1"/>
                            <Line StartPoint="10,0" EndPoint="10,10" Stroke="#D3D3D3" StrokeThickness="1"/>
                        </Canvas>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Canvas.Background>

            <Canvas.ContextFlyout>
                <MenuFlyout>
                    <MenuItem Header="Copy" Command="{Binding CopyCommand}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource copy_regular}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Cut" Click="OnCutClick">
                        <MenuItem.Icon><PathIcon Data="{StaticResource cut_regular}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Paste" Click="OnPasteClick">
                        <MenuItem.Icon><PathIcon Data="{StaticResource clipboard_paste_regular}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Delete" Click="OnDeleteClick">
                        <MenuItem.Icon><PathIcon Data="{StaticResource delete_regular}" /></MenuItem.Icon>
                    </MenuItem>
                </MenuFlyout>
            </Canvas.ContextFlyout>

            <!-- rendering objects -->
            <ItemsControl 
                ItemsSource="{Binding Simulation.Objects}"
                ClipToBounds="False" 
                x:CompileBindings="False"
            >
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X, FallbackValue=0}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y, FallbackValue=0}" />
                        <Setter Property="Opacity" Value="{Binding Opacity}" />
                    </Style>
                </ItemsControl.Styles>
            </ItemsControl>

            <!-- rendering previews -->
            <ItemsControl 
                ItemsSource="{Binding Preview.Objects}"
                ClipToBounds="False"
                IsVisible="{Binding Preview.IsVisible}"
                IsHitTestVisible="False"
                x:CompileBindings="False"
            >
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X, FallbackValue=0}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y, FallbackValue=0}" />
                        <Setter Property="Opacity" Value="{Binding Opacity}" />
                    </Style>
                </ItemsControl.Styles>
            </ItemsControl>
            
            <!-- rendering selection box -->
            <Rectangle
                Stroke="DodgerBlue"
                StrokeThickness="1.5"
                Canvas.Left="{Binding Selection.X}"
                Canvas.Top="{Binding Selection.Y}"
                Width="{Binding Selection.Width}"
                Height="{Binding Selection.Height}"
                IsVisible="{Binding Selection.IsVisible}"
                IsHitTestVisible="False"
            >
                <Rectangle.Fill>
                    <SolidColorBrush Color="#2f99ef" Opacity="0.2" />
                </Rectangle.Fill>
            </Rectangle>
        </Canvas>
    </paz:ZoomBorder>
</UserControl>

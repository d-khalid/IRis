<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="IRis.Views.Main.TopMenuView"

    xmlns:vm="using:IRis.ViewModels.Main"
    x:DataType="vm:TopMenuViewModel"
    FontSize="12"
>
    <Menu>
        <MenuItem Header="File">
            <MenuItem Header="New" Command="{Binding NewCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource new_regular}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open..." Command="{Binding OpenCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource open_regular}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Save" Command="{Binding SaveCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource save_regular}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource save_edit}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Exit" Command="{Binding ExitCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource arrow_left_regular}" /></MenuItem.Icon>
            </MenuItem>
        </MenuItem>

        <MenuItem Header="Edit">
            <MenuItem Header="Undo">
                <MenuItem.Icon><PathIcon Data="{StaticResource arrow_undo_regular}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Redo">
                <MenuItem.Icon><PathIcon Data="{StaticResource arrow_redo_regular}"/></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Cut">
                <MenuItem.Icon><PathIcon Data="{StaticResource cut_regular}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy">
                <MenuItem.Icon><PathIcon Data="{StaticResource copy_regular}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Paste">
                <MenuItem.Icon><PathIcon Data="{StaticResource clipboard_paste_regular}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Delete">
                <MenuItem.Icon><PathIcon Data="{StaticResource delete_regular}" /></MenuItem.Icon>
            </MenuItem>
        </MenuItem>

        <MenuItem Header="AI">
            <MenuItem Header="Generate From Prompt">
                <MenuItem.Icon><PathIcon Data="{StaticResource star_emphasis_regular}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Generate From Image">
                <MenuItem.Icon><PathIcon Data="{StaticResource image_regular}" /></MenuItem.Icon>
            </MenuItem>
        </MenuItem>

        <MenuItem Header="Help">
            <MenuItem Header="About">
                <MenuItem.Icon><PathIcon Data="{StaticResource question_regular}" /></MenuItem.Icon>
            </MenuItem>
        </MenuItem>
    </Menu>
</UserControl>

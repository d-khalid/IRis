<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="IRis.Views.Main.LeftSidebarView"

    xmlns:vm="using:IRis.ViewModels.Main"
    x:DataType="vm:LeftSidebarViewModel"
    xmlns:views="using:IRis.Views.Main"
    FontSize="12"
>
    <UserControl.Resources>
        <Border 
            x:Key="SampleToggle" 
            Width="20" 
            Height="20"
            Background="DarkRed"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="1"
        >
            <TextBlock 
                Text="0"
                Foreground="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,0,0,1"
                FontSize="14"
                FontWeight="ExtraBold"
            />
        </Border>
        <Border
            x:Key="SampleProbe"
            Width="20" 
            Height="20"
            Background="DarkGray"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="10"
        >
            <TextBlock
                Text="?"
                Foreground="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="ExtraBold"
                Margin="0,0,0,1"
            />
        </Border>
        <Grid x:Key="SampleAnd" Width="20" Height="20">
            <Path
                Fill="White" 
                Stroke="Black" 
                StrokeThickness="2"
                Stretch="Fill"
                Data="M 0,100 L 60,100 A 40,40 0 0 0 60,0 L 0,0 Z"
            />
        </Grid>
        <Grid x:Key="SampleNot" Width="20" Height="20">
            <Path
                Fill="White"
                Stroke="Black"
                StrokeThickness="2"
                Stretch="Fill"
                Data="M 0,0 L 0,100 L 100,50 Z"
                Margin="0,0,6,0"
            />
            <Ellipse
                Width="8" Height="8"
                Stroke="Black"
                StrokeThickness="2"
                Fill="White"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
            />
        </Grid>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ToggleButton.section">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}"
                    >
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                Text="▾"
                                FontSize="16"
                                IsVisible="{TemplateBinding IsChecked}"
                                VerticalAlignment="Center"
                            />
                            <TextBlock
                                Text="▸"
                                FontSize="16"
                                IsVisible="{TemplateBinding IsChecked, Converter={x:Static BoolConverters.Not}}"
                                VerticalAlignment="Center"
                            />
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                VerticalAlignment="Center"
                            />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.section:pointerover /template/ Border">
            <Setter Property="Background" Value="#2A2D2E"/>
        </Style>

        <Style Selector="Button.item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="24,0,8,0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.item:pointerover /template/ Border">
            <Setter Property="Background" Value="#2A2D2E"/>
        </Style>
        <Style Selector="Button.item:focus /template/ Border">
            <Setter Property="Background" Value="#37373D"/>
        </Style>
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" 
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter Content="{TemplateBinding Content}" 
                                        HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.tab.active /template/ Border">
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="15,6,15,4"/>
            <Setter Property="BorderBrush" Value="DodgerBlue"/>
        </Style>
        <Style Selector="Button.tab:pointerover /template/ Border">
            <Setter Property="Background" Value="#2A2D2E"/>
        </Style>
    </UserControl.Styles>

    <views:LeftSidebarContent />
</UserControl>
